<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form" />
        <field name="arch" type="xml">
            <!-- Odoo 19 removed document_followers_text; expose the choice before the subject. -->
            <xpath expr="//field[@name='subject']" position="before">
                <field name="notify_followers" invisible="composition_mode == 'mass_mail'" />
                <div class="text-warning" invisible="notify_followers or composition_mode == 'mass_mail'">
                    Followers will not be notified, but can still access the message from the document if allowed.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
